{
  "name": "ocean-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node tools/sync-services.mjs",
    "test:services": "node --test tools/services.test.mjs",
    "test:services:browser": "node tools/sync-services.mjs && node tools/test-services-browser.mjs",
    "test:hud": "node ocean-refined/newqa/dive-hud.mjs",
    "test:schools": "node ocean-refined/newqa/distributed-ecology.mjs && node ocean-refined/newqa/school-fish.mjs",
    "test:navigation": "node ocean-refined/newqa/navigation-refined.mjs",
    "test:journey": "node ocean-refined/newqa/journey-refined.mjs",
    "test:crt": "node ocean-refined/newqa/crt-expedition.mjs",
    "test:studio": "node ocean-refined/newqa/creatures-studio.mjs",
    "test:rigs": "node ocean-refined/newqa/creature-rigs-export.mjs",
    "build": "node tools/build.mjs",
    "dev": "python serve.py --port 4190",
    "prepare:deploy": "node tools/prepare-output.mjs",
    "test:creatures": "node ocean-refined/newqa/creature-smoke.mjs ocean-refined && node ocean-refined/newqa/creature-glb-check.mjs",
    "test:encounters": "node ocean-refined/newqa/creature-encounters.mjs",
    "perf:reef": "node ocean-refined/newqa/reef-probe.mjs",
    "export:creatures": "node ocean-refined/tools/export-creature-set.mjs",
    "prepare:audio": "cd ocean-refined && node tools/prepare-audio.mjs",
    "test:build": "node tools/build-check.mjs",
    "test:encounter-lifecycle": "node ocean-refined/newqa/creature-lifecycle.mjs",
    "test:unit": "node --test tools/test-held-map.mjs tools/test-ascent-composition.mjs tools/test-cinematic-route.mjs tools/test-guided-motion.mjs tools/test-navigation-clock.mjs tools/test-settings-escape.mjs ocean-refined/newqa/creature-smoke.mjs ocean-refined/newqa/distributed-ecology.mjs ocean-refined/newqa/diver-rig.mjs ocean-refined/newqa/experience-performance.mjs ocean-refined/newqa/fish-navigation.mjs ocean-refined/newqa/moray-resident.mjs ocean-refined/newqa/movement-profile.mjs ocean-refined/newqa/safety-stop-clock.mjs ocean-refined/newqa/school-fish.mjs ocean-refined/newqa/waterline-splash.mjs",
    "smoke": "node tools/smoke.mjs",
    "check": "npm run build && npm run test:build && npm run test:services && npm run test:unit && npm run smoke && npm run test:ui",
    "test:profile": "node tools/test-profile-free-look.mjs",
    "test:surface": "node tools/test-surface-controls.mjs",
    "test:layout": "node tools/test-mobile-layout.mjs",
    "test:ui": "node tools/test-ui-system.mjs",
    "audit:reef": "node tools/audit-reef.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.10",
    "playwright": "1.62.1"
  },
  "dependencies": {
    "posthog-js": "1.438.21"
  }
}
